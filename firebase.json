{
  "hosting": {
    "public": "site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.mjs",
      "data/**",
      "index.html",
      "today.html",
      "schedule.html",
      "strategy.html",
      "content.html",
      "landing.html",
      "engineering.html",
      "voice.html",
      "competitors.html"
    ],
    "rewrites": [
      { "source": "/api/grade", "function": "gradePost", "region": "us-central1" },
      { "source": "**", "destination": "/app.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive, nosnippet"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "ignore": ["node_modules", ".git", "*.local"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
