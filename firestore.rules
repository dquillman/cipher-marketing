rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private operator dashboard - explicit admin claim required.
    match /{document=**} {
    function isMarketingAdmin() {
      return request.auth != null
        && request.auth.token.marketingAdmin == true;
    }

      allow read, write: if isMarketingAdmin();
    }
  }
}
