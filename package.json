{
  "name": "cipher-marketing",
  "version": "1.29.22",
  "private": true,
  "type": "module",
  "description": "Marketing campaign for CipherExam (cipherexam.com) — strategy docs, dashboard site, and Remotion videos for the multi-exam acquisition push.",
  "scripts": {
    "serve": "node serve.mjs",
    "test": "node --test",
    "serve:lan": "cross-env-shell HOST=0.0.0.0 node serve.mjs",
    "build": "cd site && node inline-assets.mjs && node strip-private-state.mjs && node build-app.mjs",
    "deploy": "node scripts/release.mjs",
    "seed": "node scripts/seed-firestore.mjs",
    "post-copy": "node scripts/post-copy.mjs",
    "post-copy:li": "node scripts/post-copy.mjs --platform linkedin",
    "post-copy:x": "node scripts/post-copy.mjs --platform x",
    "published:li": "node scripts/mark-published.mjs li",
    "published:x": "node scripts/mark-published.mjs x",
    "render:exam": "node scripts/render-exam.mjs",
    "videos:install": "cd videos && npm install",
    "videos:render:all": "cd videos && npm run render:all",
    "videos:studio": "cd videos && npm run studio",
    "verify:video": "node scripts/verify-video.mjs",
    "check:sync": "node scripts/check-sync.mjs",
    "check:js": "node scripts/check-html-js.mjs",
    "predeploy:hosting": "node scripts/check-html-js.mjs",
    "release": "node scripts/release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dquillman/cipher-marketing.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "firebase-admin": "12.7.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
